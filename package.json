{
  "name": "live-auto",
  "version": "1.0.0",
  "private": true,
  "description": "B站直播全自动切片系统 —— 决策层 + 编排层（基础设施复用 biliLive-tools HTTP API）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/cli.ts run",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "node src/probe.ts",
    "probe:dry": "node src/probe.ts --dry-run",
    "cli": "node src/cli.ts",
    "mock": "node test/mock-server.ts",
    "redact-test": "node test/redact-selftest.ts",
    "audit": "node test/credential-audit.ts",
    "smoke": "node test/smoke.ts",
    "text-test": "node test/text-integrity.ts",
    "e2e": "node test/e2e-offline.ts",
    "e2e:keep": "node test/e2e-offline.ts --keep --debug",
    "subtitle-test": "node test/subtitle-glossary.ts",
    "title-test": "node test/publish-title-audit.ts",
    "clip-boundary-test": "node test/clip-boundary.ts",
    "delete-test": "node test/delete-semantics.ts",
    "trigger-scope-test": "node test/trigger-scope.ts",
    "recordings-test": "node test/recordings.ts",
    "config-test": "node test/config-checks.ts",
    "real": "node test/real-media.ts",
    "selftest": "node test/redact-selftest.ts && node test/smoke.ts",
    "verify": "npm run typecheck && npm run text-test && npm run config-test && npm run audit && npm run redact-test && npm run subtitle-test && npm run streamer-test && npm run av-sync-test && npm run title-test && npm run clip-boundary-test && npm run delete-test && npm run trigger-scope-test && npm run recordings-test && npm run watch-test && npm run watch-skip-burn-test && npm run pending-delete-test && npm run monitor-panel-test && npm run error-report-test && npm run local-funasr-test && npm run desc-notice-test && npm run clip-actions-test && npm run import-source-test && npm run resume-target-test && npm run multipart-routing-test && npm run confirm-append-test && npm run fingerprint-dedup-test && npm run fingerprint-tombstone-test && npm run segment-danmaku-test && npm run multipart-cut-snapshot-test && npm run mcp-test && npm run trash-test && npm run config-conflict-test && npm run config-conflict-e2e && npm run select-slot-test && npm run e2e && npm run smoke && npm run real",
    "trash-test": "node test/trash.ts",
    "av-sync-test": "node test/av-sync.ts",
    "watch-test": "node test/watch-import.ts",
    "pending-delete-test": "node test/pending-delete.ts",
    "monitor-panel-test": "node test/monitor-panel.ts",
    "error-report-test": "node test/error-report.ts",
    "error-report-ui": "node --experimental-strip-types tools/verify-error-report-ui.ts",
    "errors-archive-mock": "node tools/archive-mock-errors.ts",
    "hotwords-ab": "node --experimental-strip-types tools/local-asr/hotwords-ab.ts",
    "asr-timing": "node --experimental-strip-types tools/local-asr/timing.ts",
    "streamer-test": "node test/streamer.ts",
    "mcp-test": "node test/mcp.ts",
    "select-slot-test": "node --experimental-strip-types tools/local-asr/verify-select-slot.ts",
    "select-slot-paid": "node --experimental-strip-types tools/local-asr/verify-select-slot.ts --allow-paid",
    "config-conflict-test": "node test/config-conflict.ts",
    "config-conflict-e2e": "node test/config-conflict-e2e.ts",
    "local-funasr-test": "node test/local-funasr-provider.ts",
    "multipart-routing-test": "node test/multipart-routing.ts",
    "ui-e2e": "node tools/ui-e2e.ts",
    "tombstone-ui": "node --experimental-strip-types tools/verify-tombstone-ui.ts",
    "monitor-ui": "node --experimental-strip-types tools/verify-monitor-ui.ts",
    "mcp-e2e": "node tools/mcp-e2e.ts",
    "provider-e2e": "node tools/local-asr/provider-e2e.ts",
    "verify-ops": "node tools/verify-ops.ts",
    "resume-target-test": "node test/resume-target.ts",
    "confirm-append-test": "node test/confirm-append.ts",
    "fingerprint-dedup-test": "node test/fingerprint-dedup.ts",
    "multipart-cut-snapshot-test": "node test/multipart-cut-snapshot.ts",
    "import-source-test": "node test/import-source.ts",
    "clip-actions-test": "node test/clip-actions.ts",
    "desc-notice-test": "node test/desc-notice.ts",
    "watch-skip-burn-test": "node test/watch-skip-burn-product.ts",
    "fingerprint-tombstone-test": "node test/fingerprint-tombstone.ts",
    "segment-danmaku-test": "node test/segment-danmaku.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "p-limit": "^7.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
